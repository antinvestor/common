# Makefile.common — Shared build logic for Ant Investor services.
# Include this from your service Makefile after setting config variables.
#
# Usage in service Makefile:
#   SERVICE_NAME := profile
#   APP_DIRS     := apps/default apps/devices
#   include .tmp/Makefile.common
#
# Required variables (set BEFORE include):
#   SERVICE_NAME  — service identifier (e.g., profile, payment)
#
# Optional variables (have defaults):
#   PROTO_DIR     — proto directory (default: proto)
#   DEFAULT_APP   — primary app for OPL output (default: apps/default)
#   APP_DIRS      — all app directories (default: apps/default)
#   TOOLS_VER     — common tools version (default: latest)
#   BIN           — tool binary directory (default: .tmp/bin)

SHELL := bash
.SHELLFLAGS := -eu -o pipefail -c
.DEFAULT_GOAL := all

MAKEFLAGS += --warn-undefined-variables
MAKEFLAGS += --no-builtin-rules
MAKEFLAGS += --no-print-directory

# Defaults for optional variables
PROTO_DIR        ?= proto
DEFAULT_APP      ?= apps/default
APP_DIRS         ?= apps/default
BIN              ?= $(abspath .tmp/bin)
GO               ?= go
TOOLS_VER        ?= v1.1.0
COPYRIGHT_YEARS  ?= 2023-2026
COPYRIGHT_HOLDER ?= Ant Investor Ltd

export PATH  := $(BIN):$(PATH)
export GOBIN := $(BIN)

# ------------------------------------------------------------------------------
# Tool bootstrap
# ------------------------------------------------------------------------------

$(BIN)/buf:
	@mkdir -p $(BIN)
	$(GO) install github.com/bufbuild/buf/cmd/buf@latest

$(BIN)/license-header:
	@mkdir -p $(BIN)
	$(GO) install github.com/bufbuild/buf/private/pkg/licenseheader/cmd/license-header@latest

$(BIN)/golangci-lint:
	@mkdir -p $(BIN)
	$(GO) install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest

$(BIN)/inject-permissions:
	@mkdir -p $(BIN)
	$(GO) install github.com/antinvestor/common/tools/inject-permissions@$(TOOLS_VER)

$(BIN)/generate-opl:
	@mkdir -p $(BIN)
	$(GO) install github.com/antinvestor/common/tools/generate-opl@$(TOOLS_VER)

# ------------------------------------------------------------------------------
# Proto targets
# ------------------------------------------------------------------------------

.PHONY: proto-lint
proto-lint: $(BIN)/buf ## Format and lint protobuf
	@if [ -d "$(PROTO_DIR)" ]; then \
		cd $(PROTO_DIR) && buf format -w && buf lint; \
	fi

.PHONY: proto-deps
proto-deps: $(BIN)/buf ## Update buf dependencies
	@if [ -d "$(PROTO_DIR)" ]; then \
		cd $(PROTO_DIR) && buf dep update; \
	fi

.PHONY: proto-generate
proto-generate: $(BIN)/buf $(BIN)/inject-permissions $(BIN)/generate-opl $(BIN)/license-header ## Generate all artifacts from proto
	@if [ ! -d "$(PROTO_DIR)" ]; then echo "no proto/ directory, skipping generation"; exit 0; fi
	@echo "==> buf generate $(SERVICE_NAME)"
	@cd $(PROTO_DIR) && buf dep update && buf generate
	@# Inject permissions into OpenAPI specs
	@for app_dir in $(APP_DIRS); do \
		for f in $$(find $$app_dir -name '*.openapi.yaml' 2>/dev/null); do \
			echo "==> inject-permissions $$f"; \
			buf build $(PROTO_DIR) -o /dev/stdout | $(BIN)/inject-permissions "$$f"; \
		done; \
	done
	@# Generate OPL TypeScript
	@echo "==> generate-opl $(SERVICE_NAME)"
	@buf build $(PROTO_DIR) -o /dev/stdout | $(BIN)/generate-opl $(DEFAULT_APP)
	@# License headers
	@$(BIN)/license-header \
		--license-type apache \
		--copyright-holder "$(COPYRIGHT_HOLDER)" \
		--year-range "$(COPYRIGHT_YEARS)" \
		--ignore /testdata/ --ignore /sdk/ --ignore /.tmp/

.PHONY: proto-push
proto-push: $(BIN)/buf ## Push proto to BSR
	@cd $(PROTO_DIR) && buf push

# ------------------------------------------------------------------------------
# Go targets
# ------------------------------------------------------------------------------

.PHONY: build
build: proto-generate ## Build all app binaries
	@for app_dir in $(APP_DIRS); do \
		if [ -d "$$app_dir/cmd" ]; then \
			echo "==> building $$app_dir"; \
			$(GO) build ./$$app_dir/cmd/...; \
		fi; \
	done

.PHONY: test
test: ## Run all tests with race detection
	$(GO) test -vet=off -race -cover ./...

.PHONY: vet
vet: ## Vet Go code
	$(GO) vet ./...

.PHONY: lint
lint: $(BIN)/golangci-lint ## Lint Go code
	$(GO) vet ./...
	golangci-lint run

.PHONY: lintfix
lintfix: $(BIN)/golangci-lint ## Auto-fix lint issues
	golangci-lint run --fix

.PHONY: tidy
tidy: ## Tidy Go modules
	$(GO) mod tidy
	$(GO) fmt ./...

# ------------------------------------------------------------------------------
# Aggregate targets
# ------------------------------------------------------------------------------

.PHONY: all
all: proto-lint build test lint ## Full pipeline: lint protos, generate, build, test, lint Go

.PHONY: generate
generate: proto-generate ## Alias for proto-generate

.PHONY: clean
clean: ## Delete generated / temporary files
	rm -rf $(BIN)

.PHONY: help
help: ## Show this help
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | sort | \
	awk 'BEGIN {FS = ":.*?## "}; {printf "%-28s %s\n", $$1, $$2}'

# ------------------------------------------------------------------------------
# Self-update: download latest Makefile.common from common repo
# ------------------------------------------------------------------------------

.PHONY: update-makefile
update-makefile: ## Download latest Makefile.common from antinvestor/common
	@mkdir -p .tmp
	@curl -sSfL https://raw.githubusercontent.com/antinvestor/common/main/Makefile.common -o .tmp/Makefile.common
	@echo "Updated .tmp/Makefile.common"

# Makefile.common — Shared build logic for Ant Investor services.
# Include this from your service Makefile after setting config variables.
#
# Usage in service Makefile:
#   SERVICE_NAME := profile
#   APP_DIRS     := apps/default apps/devices
#   include .tmp/Makefile.common
#
# Required variables (set BEFORE include):
#   SERVICE_NAME  — service identifier (e.g., profile, payment)
#
# Optional variables (have defaults):
#   PROTO_DIR     — proto directory (default: proto)
#   DEFAULT_APP   — primary app for OPL output (default: apps/default)
#   APP_DIRS      — all app directories (default: apps/default)
#   TOOLS_VER     — common tools version (default: v1.1.0)
#   BIN           — tool binary directory (default: .tmp/bin)
#   HAS_UI        — set to true to enable Flutter UI targets (default: false)
#   UI_DIR        — Flutter UI directory (default: ui)
#   FLUTTER_HOME  — Flutter SDK location (default: $HOME/flutter)
#   OIDC_CLIENT_ID — OAuth client ID passed via --dart-define (default: empty)
#   OIDC_ISSUER    — OAuth issuer URL passed via --dart-define (default: empty)

SHELL := bash
.SHELLFLAGS := -eu -o pipefail -c
.DEFAULT_GOAL := all

MAKEFLAGS += --warn-undefined-variables
MAKEFLAGS += --no-builtin-rules
MAKEFLAGS += --no-print-directory

# Defaults for optional variables
PROTO_DIR        ?= proto
DEFAULT_APP      ?= apps/default
APP_DIRS         ?= apps/default
BIN              ?= $(abspath .tmp/bin)
GO               ?= go
TOOLS_VER        ?= v1.1.0
COPYRIGHT_YEARS  ?= 2023-2026
COPYRIGHT_HOLDER ?= Ant Investor Ltd
HAS_UI           ?= false
UI_DIR           ?= ui

export PATH  := $(BIN):$(PATH)
export GOBIN := $(BIN)

# ------------------------------------------------------------------------------
# Tool bootstrap
# ------------------------------------------------------------------------------

$(BIN)/buf:
	@mkdir -p $(BIN)
	$(GO) install github.com/bufbuild/buf/cmd/buf@latest

$(BIN)/license-header:
	@mkdir -p $(BIN)
	$(GO) install github.com/bufbuild/buf/private/pkg/licenseheader/cmd/license-header@latest

$(BIN)/golangci-lint:
	@mkdir -p $(BIN)
	$(GO) install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest

$(BIN)/inject-permissions:
	@mkdir -p $(BIN)
	$(GO) install github.com/antinvestor/common/tools/inject-permissions@$(TOOLS_VER)

$(BIN)/generate-opl:
	@mkdir -p $(BIN)
	$(GO) install github.com/antinvestor/common/tools/generate-opl@$(TOOLS_VER)

# ------------------------------------------------------------------------------
# Proto targets
# ------------------------------------------------------------------------------

.PHONY: proto-lint
proto-lint: $(BIN)/buf ## Format and lint protobuf
	@if [ -d "$(PROTO_DIR)" ]; then \
		cd $(PROTO_DIR) && buf format -w && buf lint; \
	fi

.PHONY: proto-deps
proto-deps: $(BIN)/buf ## Update buf dependencies
	@if [ -d "$(PROTO_DIR)" ]; then \
		cd $(PROTO_DIR) && buf dep update; \
	fi

.PHONY: proto-generate
proto-generate: $(BIN)/buf $(BIN)/inject-permissions $(BIN)/generate-opl $(BIN)/license-header ## Generate all artifacts from proto
	@if [ ! -d "$(PROTO_DIR)" ]; then echo "no proto/ directory, skipping generation"; exit 0; fi
	@echo "==> buf generate $(SERVICE_NAME)"
	@cd $(PROTO_DIR) && buf dep update && buf generate
	@# Inject permissions into OpenAPI specs
	@for app_dir in $(APP_DIRS); do \
		for f in $$(find $$app_dir -name '*.openapi.yaml' 2>/dev/null); do \
			echo "==> inject-permissions $$f"; \
			buf build $(PROTO_DIR) -o /dev/stdout | $(BIN)/inject-permissions "$$f"; \
		done; \
	done
	@# Generate OPL TypeScript
	@echo "==> generate-opl $(SERVICE_NAME)"
	@buf build $(PROTO_DIR) -o /dev/stdout | $(BIN)/generate-opl $(DEFAULT_APP)
	@# License headers
	@$(BIN)/license-header \
		--license-type apache \
		--copyright-holder "$(COPYRIGHT_HOLDER)" \
		--year-range "$(COPYRIGHT_YEARS)" \
		--ignore /testdata/ --ignore /sdk/ --ignore /.tmp/

.PHONY: proto-push
proto-push: $(BIN)/buf ## Push proto to BSR
	@cd $(PROTO_DIR) && buf push

# ------------------------------------------------------------------------------
# Go targets
# ------------------------------------------------------------------------------

.PHONY: build
build: proto-generate ## Build all app binaries
	@for app_dir in $(APP_DIRS); do \
		if [ -d "$$app_dir/cmd" ]; then \
			echo "==> building $$app_dir"; \
			$(GO) build ./$$app_dir/cmd/...; \
		fi; \
	done

.PHONY: test
test: ## Run all tests (sequential packages, no race detection)
	# -p 1 runs one package at a time. Services in this org commonly use
	# testcontainers (Hydra, Postgres, partition/profile/device services);
	# parallel package execution causes container resource contention and
	# auth-token invalidation between concurrently-starting stacks.
	#
	# -race is omitted here because pitabwire/frame's queue.subscriber.Stop()
	# is not goroutine-safe with respect to its own listener goroutine. The
	# race fires reliably during service cleanup in any test that instantiates
	# a frame.Service (which is most of our integration suites). Until the
	# upstream frame library fixes this, -race would make `make test` flaky.
	$(GO) test -vet=off -cover -p 1 ./...

.PHONY: vet
vet: ## Vet Go code
	$(GO) vet ./...

.PHONY: format
format: $(BIN)/golangci-lint ## Format, vet, and lint Go code
	$(GO) fmt ./...
	$(GO) vet ./...
	golangci-lint run --fix

.PHONY: lint
lint: $(BIN)/golangci-lint ## Lint Go code
	$(GO) vet ./...
	golangci-lint run

.PHONY: lintfix
lintfix: $(BIN)/golangci-lint ## Auto-fix lint issues
	golangci-lint run --fix

.PHONY: tidy
tidy: ## Tidy Go modules
	$(GO) mod tidy
	$(GO) fmt ./...

# ------------------------------------------------------------------------------
# Flutter UI targets (enabled when HAS_UI=true)
# ------------------------------------------------------------------------------

ifeq ($(HAS_UI),true)

FLUTTER_HOME   ?= $(HOME)/flutter
FLUTTER        := $(FLUTTER_HOME)/bin/flutter
DART           := $(FLUTTER_HOME)/bin/dart
OIDC_CLIENT_ID ?=
OIDC_ISSUER    ?=

# Build the --dart-define flags only when the variables are non-empty
_DART_DEFINES :=
ifneq ($(strip $(OIDC_CLIENT_ID)),)
  _DART_DEFINES += --dart-define=OIDC_CLIENT_ID=$(OIDC_CLIENT_ID)
endif
ifneq ($(strip $(OIDC_ISSUER)),)
  _DART_DEFINES += --dart-define=OIDC_ISSUER=$(OIDC_ISSUER)
endif

.PHONY: flutter-install
flutter-install: ## Download and install Flutter SDK (stable) if not present
	@if [ -x "$(FLUTTER)" ]; then \
		echo "Flutter already installed: $$("$(FLUTTER)" --version | head -1)"; \
	else \
		echo "==> Installing Flutter SDK (stable)..."; \
		FLUTTER_URL=$$(curl -s https://storage.googleapis.com/flutter_infra_release/releases/releases_linux.json \
			| python3 -c "import json,sys; r=json.load(sys.stdin); print('https://storage.googleapis.com/flutter_infra_release/releases/' + [x for x in r['releases'] if x['hash']==r['current_release']['stable']][0]['archive'])"); \
		echo "Downloading $$FLUTTER_URL"; \
		curl -sL "$$FLUTTER_URL" | tar xJ -C "$(dir $(FLUTTER_HOME))"; \
		"$(FLUTTER)" precache --web; \
		echo "Flutter installed: $$("$(FLUTTER)" --version | head -1)"; \
	fi

# Keep flutter-setup as an alias for backward compatibility
.PHONY: flutter-setup
flutter-setup: flutter-install

.PHONY: ui-deps
ui-deps: flutter-install ## Install Flutter dependencies
	cd $(UI_DIR) && "$(FLUTTER)" pub get

.PHONY: ui-generate
ui-generate: ui-deps ## Run build_runner code generation
	@if grep -q 'build_runner' $(UI_DIR)/pubspec.yaml 2>/dev/null; then \
		cd $(UI_DIR) && "$(DART)" run build_runner build --delete-conflicting-outputs; \
	fi

.PHONY: ui-analyze
ui-analyze: ui-deps ## Analyze Flutter code
	cd $(UI_DIR) && "$(FLUTTER)" analyze

.PHONY: ui-test
ui-test: ui-generate ## Run Flutter tests
	cd $(UI_DIR) && "$(FLUTTER)" test

.PHONY: ui-build-dev
ui-build-dev: ui-generate ## Build Flutter web (development)
	cd $(UI_DIR) && "$(FLUTTER)" build web \
		--profile \
		--base-href="/" \
		$(_DART_DEFINES) \
		--source-maps
	@echo "Dev build: $(UI_DIR)/build/web/"

.PHONY: ui-build-prod
ui-build-prod: ui-generate ## Build Flutter web (production)
	cd $(UI_DIR) && "$(FLUTTER)" build web \
		--release \
		--base-href="/" \
		--tree-shake-icons \
		$(_DART_DEFINES)
	@echo "Production build: $(UI_DIR)/build/web/"

.PHONY: ui-build
ui-build: ui-build-dev ## Default UI build (development)

.PHONY: ui-clean
ui-clean: ## Clean Flutter build artifacts
	cd $(UI_DIR) && "$(FLUTTER)" clean
	rm -rf $(UI_DIR)/build

endif # HAS_UI

# ------------------------------------------------------------------------------
# Aggregate targets
# ------------------------------------------------------------------------------

ifeq ($(HAS_UI),true)
.PHONY: all
all: proto-lint build test lint ui-analyze ui-test ## Full pipeline: protos, Go build+test+lint, Flutter analyze+test
else
.PHONY: all
all: proto-lint build test lint ## Full pipeline: lint protos, generate, build, test, lint Go
endif

.PHONY: generate
generate: proto-generate ## Alias for proto-generate

ifeq ($(HAS_UI),true)
.PHONY: clean
clean: ui-clean ## Delete generated / temporary files
	rm -rf $(BIN)
else
.PHONY: clean
clean: ## Delete generated / temporary files
	rm -rf $(BIN)
endif

.PHONY: help
help: ## Show this help
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | sort | \
	awk 'BEGIN {FS = ":.*?## "}; {printf "%-28s %s\n", $$1, $$2}'

# ------------------------------------------------------------------------------
# Self-update: download latest Makefile.common from common repo
# ------------------------------------------------------------------------------

.PHONY: update-makefile
update-makefile: ## Download latest Makefile.common from antinvestor/common
	@mkdir -p .tmp
	@curl -sSfL https://raw.githubusercontent.com/antinvestor/common/main/Makefile.common -o .tmp/Makefile.common
	@echo "Updated .tmp/Makefile.common"
